<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\VitalFace.Core\VitalFace.Core.csproj" />
    <ProjectReference Include="..\VitalFace.Infrastructure\VitalFace.Infrastructure.csproj" />
    <ProjectReference Include="..\VitalFace.Contracts\VitalFace.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- Pinned explicitly: without it, this project's own dependency graph resolves an older EF
         Core reference (10.0.4, from the ASP.NET Core shared framework baseline) than the one
         VitalFace.Infrastructure actually ships (10.0.12 via Npgsql.EntityFrameworkCore.PostgreSQL),
         which is a hard build error (CS1705), not just a warning. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
